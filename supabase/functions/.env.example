# ---------- EDGE FUNCTION SECRETS ----------
# Copy to supabase/functions/.env, fill in what you're using, then run:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
# IMPORTANT: delete any line below you are not using yet - an empty value can
# make 'secrets set' fail.

# Your Vercel site address (used for links inside emails)
APP_URL=https://your-app.vercel.app

# Only needed if you later set up the optional daily automatic email (see the guide).
# A random string you make up yourself - it just has to match in both places.
CRON_SECRET=change-me-to-a-long-random-string

# ----- Email (Resend free tier) -----
RESEND_API_KEY=
EMAIL_FROM=LoanTrack <onboarding@resend.dev>

# ----- Google Calendar -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# 'all' = Google emails an invitation to every admin for every event, 'none' = silent
CALENDAR_SEND_INVITES=all
